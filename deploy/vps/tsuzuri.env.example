# 設定ファイルの雛形。置き場所：Docker 版は ~/tsuzuri/tsuzuri.env（600、deploy/docker/init.sh が作る）、
# systemd 版は /etc/tsuzuri/tsuzuri.env（root:tsuzuri、640、deploy/vps/setup.sh が作る）
# この内容は秘密値を含む。リポジトリやチャットに貼らない。

# ---- 公開 URL とポート（リバースプロキシの後ろで待ち受ける。Docker 版は compose.yml が上書きする） ----
PUBLIC_BASE_URL=https://mail.example.com
PORT=8787
HOST=127.0.0.1

# ---- データベース（Supabase の Transaction pooler、または VPS 上の PostgreSQL） ----
DATABASE_URL=
# Supabase の場合：CA 証明書を設定ファイルと同じ場所に supabase-ca.crt として置く
# （Docker 版は init.sh が /config/supabase-ca.crt に書き換える。値を書くときは \ ではなく / で区切る）
DATABASE_CA_FILE=/etc/tsuzuri/supabase-ca.crt
DATABASE_CA_SHA256=807025AD50D4ED219D2C9C7D299C004F824EB00CF7F65AFEF607D07B72E6CAFA

# ---- 署名用の鍵（setup.sh が自動で作る。作り直すと送信済みメールの配信停止リンクが無効になる） ----
TOKEN_SECRET=

# ---- 管理画面（admin:setup で書き込む。docs/vps.md の「管理画面のログイン情報」） ----
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# ---- AWS（SES の送信とイベントの受け取り。IAM ユーザー tsuzuri-vps のアクセスキー） ----
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=tsuzuri
# infra の Outputs の SesEventsQueueUrl
SES_EVENTS_QUEUE_URL=
# SES の送信レート（通/秒）。サンドボックス中は 1。本番承認後は承認された値に合わせる
MAX_SEND_RATE=1

# ---- 送信者の初期値（管理画面の「設定」で上書きできる） ----
MAIL_FROM_ADDRESS=info@mail.example.com
MAIL_FROM_NAME=
MAIL_REPLY_TO=
MAIL_CONTACT=
PRIVACY_URL=

# ---- ファイルとバックアップ（Docker 版は compose.yml が /data/... に上書きする） ----
FILES_DIR=/var/lib/tsuzuri/files
BACKUP_DIR=/var/lib/tsuzuri/backups
BACKUP_KEEP_DAYS=30

# 動作確認だけしたいときは console にすると、メールを送らずログに出す
# MAIL_PROVIDER=console
