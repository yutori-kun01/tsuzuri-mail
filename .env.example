# コピーして .env を作り、値を埋める（.env はコミットしない）
AWS_REGION=ap-northeast-1
MAIL_FROM_ADDRESS=info@ml.example.com
MAIL_FROM_NAME=
MAIL_REPLY_TO=
UNSUBSCRIBE_SECRET=
PUBLIC_BASE_URL=https://example.com
DATABASE_URL=postgres://user:pass@localhost:5432/tsuzuri
# Supabase の場合：Project Settings → Database → SSL Configuration から CA をダウンロードし、その場所を書く
# DATABASE_CA_FILE=C:/Users/<you>/certs/supabase-prod-ca-2021.crt
# DATABASE_CA_SHA256=807025AD50D4ED219D2C9C7D299C004F824EB00CF7F65AFEF607D07B72E6CAFA
